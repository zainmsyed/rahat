# Rahat production runtime configuration for the single-container Docker deployment.
# Copy to .env only for local operator use; do not commit secrets.

APP_ENV=production
LOG_LEVEL=info
RAHAT_HTTP_ADDR=:8080
DATABASE_PATH=/data/rahat.sqlite3
WEB_STATIC_DIR=/app/web/static
WEB_ORIGIN=https://<your-domain>
# Local/LAN example for phone testing: http://192.168.1.20:8080

# Required secrets: replace every placeholder with a long random value.
WEB_SESSION_SECRET=<32+ random chars>
LOOKAHEAD_TOKEN_SECRET=<32+ random chars>

# Telegram long polling. Set the bot token to enable Telegram integration.
# Leave webhook settings empty to keep webhook mode off (recommended for Coolify/local deployments).
TELEGRAM_BOT_TOKEN=<telegram bot token>
TELEGRAM_BOT_USERNAME=<telegram bot username, optional>
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_API_BASE_URL=
# For local/LAN phone testing, set this to the same phone-reachable host:port
# used by WEB_ORIGIN, for example 192.168.1.20:8080. Do not use localhost.
TELEGRAM_LINK_HOST=

# Optional onboarding and operations settings.
ONBOARDING_INVITE_CODE=rahat-beta
BACKUP_TARGET_URI=
EMAIL_RECAP_OUTBOX_DIR=/data/email-outbox
LOOKAHEAD_TOKEN_ISSUER_ENABLED=false
RAHAT_RESET_CONFIRM=

# Optional Google Calendar integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://<your-domain>/onboarding/calendar/callback
GOOGLE_CALENDAR_ID=primary

# Optional Docker build argument. Same-origin deployment should leave it empty.
# VITE_API_BASE_URL=
