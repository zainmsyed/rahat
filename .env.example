APP_ENV=development
LOG_LEVEL=info
RAHAT_HTTP_ADDR=:8080
DATABASE_PATH=./var/rahat.sqlite3
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Onboarding invite code (defaults to rahat-beta if omitted)
ONBOARDING_INVITE_CODE=rahat-beta

# Telegram bot configuration (optional; without it, onboarding falls back to email-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_API_BASE_URL=
